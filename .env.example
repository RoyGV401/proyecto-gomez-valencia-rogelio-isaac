# =============================================================================
# Configuración del Proyecto: Inventario de Laboratorio (Dominio 6 - Equipo)
# Copia este archivo como .env y reemplaza los valores de ejemplo.
# =============================================================================

# --- Base de Datos (MariaDB) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=inventario_db
DB_USER=app_user
DB_PASSWORD=change_me_in_production

# Variables requeridas por la imagen oficial de MariaDB en Docker Hub
MARIADB_DATABASE=inventario_db
MARIADB_USER=app_user
MARIADB_PASSWORD=change_me_in_production
MARIADB_ROOT_PASSWORD=change_me_root_in_production

# --- Redis (Caché y Contador) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_TTL=30

# --- Mailpit / SMTP (Notificaciones por Correo) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=notificaciones@laboratorio.local
SMTP_TO=admin@laboratorio.local

# --- Puertos Expuestos al Host ---
FRONTEND_PORT=8081
MAILPIT_UI_PORT=8025
